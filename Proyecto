    font-size: 35px;

    color: #fff;
}

.stats span {

    color: #666;

    font-size: 9px;

    letter-spacing: 2px;
}


/* =========================
   SECCIONES
========================= */

.section {

    padding: 150px 8%;
}

.section-title {

    display: flex;

    justify-content: space-between;

    align-items: end;

    margin-bottom: 70px;
}

.mini-title {

    color: #00ffb7;

    font-family: Orbitron;

    font-size: 10px;

    letter-spacing: 3px;

    margin-bottom: 20px;
}

.section h2,
.contact h2 {

    font-family: Orbitron;

    font-size: clamp(45px,6vw,80px);

