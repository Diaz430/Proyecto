* {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
}

html {
    scroll-behavior: smooth;
}

body {
    background: #050507;
    color: white;
    font-family: "Inter", sans-serif;
    overflow-x: hidden;
}

/* =========================
   FONDO
========================= */

.grid {
    position: fixed;
    inset: 0;
    z-index: -3;

    background-image:
        linear-gradient(rgba(0,255,183,.035) 1px, transparent 1px),
        linear-gradient(90deg, rgba(0,255,183,.035) 1px, transparent 1px);

    background-size: 50px 50px;

    mask-image: linear-gradient(
        to bottom,
        black,
        transparent
    );
}

body::before {
    content: "";

    position: fixed;
    width: 700px;
    height: 700px;

    left: 50%;
    top: 40%;

    transform: translate(-50%, -50%);

    background: radial-gradient(
        circle,
        rgba(0,255,183,.08),
        transparent 65%
    );

    pointer-events: none;

    z-index: -2;
}


/* =========================
   PARTICULAS
========================= */

#particles {
    position: fixed;
    inset: 0;

    pointer-events: none;

    z-index: -1;
}

.particle {
    position: absolute;

    width: 3px;
    height: 3px;

    border-radius: 50%;

    background: #00ffb7;

    box-shadow:
        0 0 5px #00ffb7,
        0 0 15px #00ffb7;

    animation: floatParticle linear infinite;
}

@keyframes floatParticle {

    from {
        transform: translateY(110vh);
        opacity: 0;
    }

    20% {
        opacity: 1;
    }

    80% {
        opacity: 1;
    }

    to {
        transform: translateY(-10vh);
        opacity: 0;
    }

}


/* =========================
   NAVBAR
========================= */

.navbar {

    position: fixed;

    top: 0;
    left: 0;

    width: 100%;

    height: 80px;

    padding: 0 7%;

    display: flex;

    align-items: center;

    justify-content: space-between;

    z-index: 100;

    background: rgba(5,5,7,.75);

    backdrop-filter: blur(15px);

    border-bottom: 1px solid rgba(255,255,255,.08);
}

.logo {

    text-decoration: none;

    color: white;

    font-family: Orbitron;

    font-weight: 800;

    letter-spacing: 3px;

    font-size: 20px;
}

.logo span {

    color: #00ffb7;

    text-shadow:
        0 0 10px #00ffb7,
        0 0 25px #00ffb7;
}

.navbar nav {

    display: flex;

    gap: 35px;
}

.navbar nav a {

    color: #888;

    text-decoration: none;

    font-size: 10px;

    letter-spacing: 2px;

    transition: .3s;
}

.navbar nav a:hover {

    color: #00ffb7;

    text-shadow:
        0 0 10px #00ffb7;
}

#themeButton {

    width: 40px;
    height: 40px;

    border-radius: 50%;

    border: 1px solid #333;

    background: transparent;

    color: white;

    cursor: pointer;

    transition: .3s;
}

#themeButton:hover {

    border-color: #00ffb7;

    box-shadow:
        0 0 15px rgba(0,255,183,.5);
}


/* =========================
   HERO
========================= */

.hero {

    min-height: 100vh;

    padding: 140px 8% 70px;

    display: grid;

    grid-template-columns: 1.1fr .9fr;

    align-items: center;

    position: relative;
}

.status {

    color: #00ffb7;

    font-family: Orbitron;

    font-size: 10px;

    letter-spacing: 3px;

    margin-bottom: 25px;
}

.status span {

    display: inline-block;

    width: 7px;
    height: 7px;

    border-radius: 50%;

    background: #00ffb7;

    margin-right: 10px;

    box-shadow:
        0 0 10px #00ffb7,
        0 0 25px #00ffb7;

    animation: pulse 1.2s infinite;
}

@keyframes pulse {

    0%,100% {
        opacity: 1;
        transform: scale(1);
    }

    50% {
        opacity: .4;
        transform: scale(.6);
    }

}

.hero h1 {

    font-family: Orbitron;

    font-size: clamp(55px,8vw,120px);

    line-height: .9;

    letter-spacing: -5px;
}

.hero h1 strong {

    color: #00ffb7;

    text-shadow:
        0 0 5px #00ffb7,
        0 0 15px #00ffb7,
        0 0 40px rgba(0,255,183,.7);

    animation: neonText 2s infinite alternate;
}

@keyframes neonText {

    from {
        text-shadow:
            0 0 5px #00ffb7,
            0 0 15px #00ffb7;
    }

    to {
        text-shadow:
            0 0 5px #00ffb7,
            0 0 20px #00ffb7,
            0 0 50px #00ffb7;
    }

}

.hero-content > p {

    max-width: 570px;

    color: #888;

    line-height: 1.8;

    margin: 35px 0;

    font-size: 14px;
}


/* =========================
   BOTONES
========================= */

.buttons {

    display: flex;

    gap: 15px;
}

.btn {

    position: relative;

    display: inline-block;

    padding: 16px 25px;

    text-decoration: none;

    color: white;

    border: 1px solid #333;

    font-family: Orbitron;

    font-size: 10px;

    letter-spacing: 2px;

    overflow: hidden;

    transition: .3s;
}

.btn::before {

    content: "";

    position: absolute;

    left: -100%;

    top: 0;

    width: 100%;

    height: 100%;

    background: #00ffb7;

    transition: .4s;

    z-index: -1;
}

.btn:hover::before {

    left: 0;
}

.btn:hover {

    color: #050507;

    border-color: #00ffb7;

    box-shadow:
        0 0 10px #00ffb7,
        0 0 30px rgba(0,255,183,.4);
}

.btn.neon {

    background: #00ffb7;

    color: #050507;

    border-color: #00ffb7;

    box-shadow:
        0 0 10px rgba(0,255,183,.6);
}

.btn.neon:hover {

    box-shadow:
        0 0 10px #00ffb7,
        0 0 30px #00ffb7,
        0 0 60px rgba(0,255,183,.5);
}

.btn span {

    margin-left: 20px;
}


/* =========================
   ORBE
========================= */

.orb-container {

    height: 500px;

    display: grid;

    place-items: center;

    position: relative;
}

.orb {

    width: 300px;
    height: 300px;

    border-radius: 50%;

    position: relative;

    display: grid;

    place-items: center;

    background:
        radial-gradient(
            circle at 35% 30%,
            #1c4940,
            #07100e 40%,
            #020303 70%
        );

    box-shadow:
        0 0 40px rgba(0,255,183,.2),
        inset 0 0 50px rgba(0,255,183,.1);

    animation: orbPulse 3s infinite alternate;
}

@keyframes orbPulse {

    from {
        box-shadow:
            0 0 30px rgba(0,255,183,.15),
            inset 0 0 40px rgba(0,255,183,.08);
    }

    to {
        box-shadow:
            0 0 90px rgba(0,255,183,.35),
            inset 0 0 70px rgba(0,255,183,.18);
    }

}

.orb-core {

    font-family: Orbitron;

    font-size: 90px;

    font-weight: 900;

    color: #00ffb7;

    text-shadow:
        0 0 10px #00ffb7,
        0 0 30px #00ffb7,
        0 0 70px #00ffb7;
}

.ring {

    position: absolute;

    border-radius: 50%;

    border: 1px solid rgba(0,255,183,.5);

    inset: -25px;

    animation: rotate 8s linear infinite;
}

.ring2 {

    inset: -55px;

    border-color: rgba(255,255,255,.15);

    animation-duration: 13s;

    animation-direction: reverse;
}

.ring3 {

    inset: -90px;

    border-style: dashed;

    opacity: .5;

    animation-duration: 20s;
}

@keyframes rotate {

    to {
        transform: rotate(360deg);
    }

}

.status-card {

    position: absolute;

    bottom: 20px;
    right: 5%;

    padding: 15px 20px;

    background: rgba(15,15,20,.85);

    border: 1px solid #292930;

    display: flex;

    align-items: center;

    gap: 12px;

    min-width: 230px;

    backdrop-filter: blur(10px);
}

.online {

    width: 7px;
    height: 7px;

    background: #00ffb7;

    border-radius: 50%;

    box-shadow:
        0 0 10px #00ffb7;
}

.status-card small,
.status-card strong {

    display: block;
}

.status-card small {

    color: #666;

    font-family: Orbitron;

    font-size: 8px;
}

.status-card strong {

    font-family: Orbitron;

    font-size: 10px;
}

.status-card b {

    margin-left: auto;

    color: #00ffb7;

    font-family: Orbitron;
}


/* =========================
   SCROLL
========================= */

.scroll {

    position: absolute;

    bottom: 25px;
    left: 8%;

    font-family: Orbitron;

    font-size: 9px;

    color: #555;

    letter-spacing: 2px;
}


/* =========================
   STATS
========================= */

.stats {

    margin: 0 8%;

    padding: 30px 0;

    display: grid;

    grid-template-columns: repeat(4,1fr);

    border-top: 1px solid #222;

    border-bottom: 1px solid #222;
